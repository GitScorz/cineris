# Normalize text in Git and use native Windows line endings for VS project files.
* text=auto
*.sln text eol=crlf
*.slnx text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

*.cpp text
*.c text
*.h text
*.hpp text
*.vert text
*.frag text
*.md text

# Wavefront models are text, unlike compiler .obj files in ignored build folders.
Assets/**/*.obj text
Assets/**/*.mtl text

*.png binary
*.jpg binary
*.jpeg binary
*.blend binary
*.lib binary
*.dll binary
*.ttf binary
